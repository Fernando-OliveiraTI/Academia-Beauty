TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3317
DB_USER=academia
DB_PASSWORD=
DB_DATABASE=academia
SESSION_DRIVER=database
LIMITER_STORE=database
ADMIN_EMAIL=admin@academia.local
ADMIN_PASSWORD=

# Invalidação de cache do site Next após publicar (URL do web + segredo compartilhado, >= 24 caracteres).
REVALIDATE_URL=http://localhost:3100/internal/revalidate
REVALIDATE_SECRET=

# Domínios autorizados para o link de checkout (Modo A), separados por vírgula. Vazio = nenhum.
CHECKOUT_ALLOWED_HOSTS=
# Token da API da The Members (botão "Sincronizar" dos cursos). Vazio = sincronização indisponível.
TOKEN_THE_MEMBERS=
# Webhook de checkout da The Members: segredo compartilhado (Checkout > Ferramentas > Webhooks) e a URL cadastrada lá.
THEMEMBERS_WEBHOOK_SECRET=
THEMEMBERS_WEBHOOK_URL=
# Registro técnico do corpo bruto de cada chamada (contém dados pessoais; só admin vê). false desliga.
THEMEMBERS_LOG_RAW=true
THEMEMBERS_LOG_RETENTION_DAYS=30
# Só fora de produção: true = o site também mostra profissionais e cursos em rascunho (teste). Ignorada em produção.
PUBLIC_SHOW_DRAFTS=false
# Cada entrada vale só para o host exato; subdomínios exigem curinga explícito (*.dominio.com).

# Proxies confiáveis (IP/CIDR, vírgula) para ler o IP real em X-Forwarded-For. Em produção atrás de proxy/ingress, defina.
TRUSTED_PROXIES=

# Mídia: pasta dos arquivos enviados (padrão storage/media) e host(s) https de CDN aceitos como mídia externa (vírgula; vazio = só o próprio site).
MEDIA_STORAGE_PATH=
MEDIA_CDN_HOST=
